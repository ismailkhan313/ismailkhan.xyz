    },
    {
      "type": "text", "id": "sw_when",
      "x": 1640, "y": 1104, "width": 660, "height": 18,
      "text": "Use when: the answer benefits from argument — and you can afford it.",
      "originalText": "Use when: the answer benefits from argument — and you can afford it.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#f08c00", "backgroundColor": "transparent",
