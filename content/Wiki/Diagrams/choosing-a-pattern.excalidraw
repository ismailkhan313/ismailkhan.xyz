    {
      "type": "text", "id": "sw_what",
      "x": 1640, "y": 1080, "width": 600, "height": 18,
      "text": "All-to-all debate between specialists. No orchestrator at all.",
      "originalText": "All-to-all debate between specialists. No orchestrator at all.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#868e96", "backgroundColor": "transparent",
